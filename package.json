{
  "name": "flat-earth-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Render the world from a point on its surface, on a globe or on a plane, and compare against what the camera sees.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sightline": "tsx src/build/cli/sightline.ts",
    "build:scene": "tsx src/build/cli/build-scene.ts",
    "resolve:scene": "tsx src/build/cli/resolve-scene.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "shots": "node scripts/screenshot.mjs",
    "build:standalone": "vite build && node scripts/build-standalone.mjs",
    "probe": "tsx src/build/cli/probe-overture.ts",
    "phone-check": "node scripts/phone-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.185.4",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.4",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "three": "^0.185.1",
    "vite": "^5.4.21"
  }
}
