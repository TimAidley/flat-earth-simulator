{
  "name": "flat-earth-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Render the world from a point on its surface, on a globe or on a plane, and compare against what the camera sees.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sightline": "tsx src/build/cli/sightline.ts",
    "build:scene": "tsx src/build/cli/build-scene.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
